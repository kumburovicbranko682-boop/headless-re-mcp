<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Headless RE-MCP" Language="1033" Version="0.1.0"
           Manufacturer="Headless RE-MCP contributors"
           UpgradeCode="A7C3E9B1-4D2F-4A8E-9C11-8F2E6D1B0A09">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="Headless reverse-engineering MCP and browser workbench (no IDA)" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="ProductFeature" Title="Core and browser workbench" Level="1">
      <ComponentGroupRef Id="ProductFiles" />
    </Feature>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="HeadlessReMcp" />
      </Directory>
    </Directory>
  </Product>
</Wix>
