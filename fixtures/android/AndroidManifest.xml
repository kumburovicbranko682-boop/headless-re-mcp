<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.headlessre.sample"
    android:versionCode="7"
    android:versionName="1.2.3">
  <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="23" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <application android:label="HeadlessSample" android:hasCode="true">
    <activity android:name="com.headlessre.sample.MainActivity">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <service android:name="com.headlessre.sample.SyncService" />
    <receiver android:name="com.headlessre.sample.BootReceiver" />
  </application>
</manifest>
